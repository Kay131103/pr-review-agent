# --- GitHub auth: set EITHER a token OR GitHub App credentials ---
PR_REVIEW_GITHUB_TOKEN=
# PR_REVIEW_GITHUB_APP_ID=123456
# PR_REVIEW_GITHUB_APP_PRIVATE_KEY_PATH=/secrets/app.pem
# PR_REVIEW_GITHUB_API_URL=https://api.github.com

# Required for webhook mode (same value as the webhook secret configured on GitHub)
PR_REVIEW_WEBHOOK_SECRET=

# --- AI review (optional) ---
# Set this to your OpenCode (oc_sk_...) or Anthropic API key.
ANTHROPIC_API_KEY=
# PR_REVIEW_LLM_MODEL=qwen3.7-max
# PR_REVIEW_LLM_BASE_URL=https://opencode.ai/zen

# --- Behaviour ---
# PR_REVIEW_FAIL_ON=error
# PR_REVIEW_REQUEST_CHANGES_ON_FAIL=false
# PR_REVIEW_MAX_INLINE_COMMENTS=30
# PR_REVIEW_DISABLED_RULES=todo-comment
# PR_REVIEW_IGNORE_PATHS=*.lock,package-lock.json,vendor/*,dist/*

# --- Polling mode (optional) ---
# PR_REVIEW_WATCH_REPOS=your-org/repo-a,your-org/repo-b
# PR_REVIEW_POLL_INTERVAL_SECONDS=120

# --- Runtime ---
# PR_REVIEW_WORKERS=4
# PR_REVIEW_DB_PATH=/data/pr_review_agent.db
# PR_REVIEW_LOG_LEVEL=INFO
# PR_REVIEW_LOG_JSON=true
